NODE_ENV=development
PORT=4001
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
DATA_DIR=./data

# Comma-separated list of allowed origins for the API, e.g.
# https://afriresq.example.org,https://staging.afriresq.example.org
# Leave blank in local dev to allow any origin.
CORS_ORIGIN=

# --- Real push notifications (Web Push / VAPID) ---
# Generate a keypair once with: npx web-push generate-vapid-keys
# Leave blank to disable push (in-app + WebSocket notifications still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@afriresq.org

# --- Real SMS delivery (Africa's Talking) ---
# Free sandbox account: https://africastalking.com
# Leave blank to fall back to simulated (console-logged) SMS.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

LOG_LEVEL=info
